# hetzner-watch — variabili d'ambiente
#
# In GitHub Actions il workflow (.github/workflows/daily.yml) imposta queste
# variabili da solo, leggendole dai secret del repo e dal contesto della run:
# non c'è nulla da configurare lì. Questo file serve solo per lanciare il job
# in locale (`uv run python -m hetzner_watch`) o per rigenerare le fixture di
# test (`uv run python scripts/capture_fixtures.py`).
#
# Copia questo file in `.env`, compila i valori, poi caricali nella shell
# prima di lanciare un comando, ad esempio:
#   set -a; source .env; set +a
# Il codice non legge `.env` da solo (nessuna dipendenza da python-dotenv):
# le variabili devono essere già nell'ambiente del processo.

# Obbligatoria (letta sia da __main__.py sia da scripts/capture_fixtures.py).
# Token API Hetzner Cloud con permesso **Read soltanto**
# (Console Hetzner → Security → API tokens → Generate API token → Read).
# Un token è legato a un singolo progetto Hetzner, non all'account: per
# monitorare più progetti genera un token per ciascuno e concatenali con la
# virgola (gli spazi intorno alla virgola vengono ignorati):
#   HCLOUD_TOKEN=token-progetto-a,token-progetto-b
# scripts/capture_fixtures.py usa solo il primo token della lista.
# In GitHub Actions viene letta dal secret del repo `HCLOUD_TOKEN` — vedi README.
HCLOUD_TOKEN=

# Obbligatoria. Repository GitHub su cui aprire/aggiornare/chiudere la issue,
# nel formato "owner/repo".
# Solo per lanci locali: in GitHub Actions è impostata automaticamente dal
# contesto della run (`${{ github.repository }}`).
GITHUB_REPOSITORY=owner/repo

# Obbligatoria per il watcher locale (`python -m hetzner_watch.availability`):
# app password di Gmail per la mail di disponibilità. In locale `.env` non si
# scrive a mano: lo rigenera `secrets-sync pull` dalla nota `env: hetzner-watch/.env`.
GMAIL_APP_PASSWORD=

# Obbligatoria. Token per l'API delle Issues di GitHub, con permesso di
# lettura/scrittura sulle issue del repo indicato sopra.
# Solo per lanci locali: in GitHub Actions è il `GITHUB_TOKEN` fornito
# automaticamente da Actions, già coperto dai permessi dichiarati nel
# workflow (`issues: write`, `contents: write`).
GITHUB_TOKEN=
