<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hetzner-watch.availability</string>

    <!-- .env is rebuilt from the vault by secrets-sync (dotfiles/secrets/manifest.toml);
         the code reads only its environment, so the shell loads the file. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -a; . ./.env; set +a; .venv/bin/python -m hetzner_watch.availability; exec .venv/bin/python -m hetzner_watch.acquire</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacopobalocco/code_repos/hetzner-watch</string>

    <!-- Every minute: cx43 stayed orderable less than ninety minutes on
         2026-10-19, and acquire.py must catch the next window. Only the Mac
         named by run_on_host in config.yaml acts; elsewhere both modules return. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/tmp/hetzner-watch-availability.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hetzner-watch-availability.err</string>

    <!-- Each run stands alone: a failed one is retried by the next. -->
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
